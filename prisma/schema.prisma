// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String?   @unique
  emailVerified  DateTime?
  image          String?
  role           String    @default("CUSTOMER")
  status         String    @default("APPROVED")
  businessName   String?
  phone          String?
  serviceArea    String?
  serviceAreaLat Float?
  serviceAreaLng Float?
  serviceRadiusKm Int?     @default(50)
  vehicleType    String?
  vehicleCapacityKg Int?
  yearsExperience Int?
  declinedReason String?
  complianceGraceUntil DateTime?
  isAvailable    Boolean   @default(true)
  lastAssignedAt DateTime?
  createdAt      DateTime  @default(now())
  accounts       Account[]
  sessions       Session[]
  orders         Order[]
  assignedOrders Order[]  @relation("ProviderAssignments")
  declines       OrderDecline[] @relation("ProviderDeclines")
  supportTickets SupportTicket[]
  quotes         Quote[]
  pricingConfigs PricingConfig[] @relation("PricingConfigCreatedBy")
  complianceDocuments ComplianceDocument[] @relation("ProviderComplianceDocuments")
  reviewedComplianceDocuments ComplianceDocument[] @relation("ComplianceDocumentReviewer")
  notifications  Notification[]
  consents       ConsentRecord[]
  offers         OrderOffer[] @relation("ProviderOffers")

  @@index([role])
  @@index([status])
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?
  user               User    @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Order {
  id                   String   @id @default(cuid())
  orderNumber          String   @unique
  customer             User     @relation(fields: [customerId], references: [id])
  customerId           String
  customerName         String
  customerEmail        String
  pickupAddress        String
  pickupPhone          String
  pickupDate           String?
  pickupTime           String?
  deliveryAddress      String
  deliveryName         String
  deliveryPhone        String
  deliveryInstructions String
  packageType          String
  weight               Float
  length               Float
  width                Float
  height               Float
  packageDescription   String
  fragile              Boolean  @default(false)
  insurance            Boolean  @default(false)
  signatureRequired    Boolean  @default(false)
  amount               Int
  description          String
  paymentMethod        String
  paymentStatus        String
  status               String
  assignedProvider     User?    @relation("ProviderAssignments", fields: [assignedProviderId], references: [id])
  assignedProviderId   String?
  assignmentAttempts   Int      @default(0)
  assignmentLastAttemptAt DateTime?
  assignmentEscalatedAt DateTime?
  assignmentUrgent     Boolean  @default(false)
  driverLat            Float?
  driverLng            Float?
  driverLocationUpdatedAt DateTime?
  baseAmount           Int?
  source               String   @default("FORM")
  packageCategory      String?
  pickupLat            Float?
  pickupLng            Float?
  deliveryLat          Float?
  deliveryLng          Float?
  acceptedAt           DateTime?
  startedAt            DateTime?
  deliveredAt          DateTime?
  paidAt               DateTime?
  arrivalDistanceM     Float?
  arrivalAccuracyM     Float?
  deliveryOverrideAt   DateTime?
  deliveryOverrideById String?
  deliveryOverrideReason String?
  distanceM            Int?
  distanceKm           Float?
  chargeableWeightKg   Float?
  pricingConfigVersion Int?
  payments             Payment[]
  declines             OrderDecline[]
  offers               OrderOffer[]
  parcels              OrderParcel[]
  quote                Quote?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([customerId])
  @@index([assignedProviderId])
  @@index([status])
  @@index([paymentStatus])
  @@index([source])
}

model OrderDecline {
  id         String   @id @default(cuid())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String
  provider   User     @relation("ProviderDeclines", fields: [providerId], references: [id])
  providerId String
  reason     String?
  createdAt  DateTime @default(now())

  @@unique([orderId, providerId])
  @@index([providerId])
}

model OrderOffer {
  id          String   @id @default(cuid())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  provider    User     @relation("ProviderOffers", fields: [providerId], references: [id], onDelete: Cascade)
  providerId  String
  status      String   @default("PENDING")
  rank        Int      @default(0)
  distanceM   Float?
  expiresAt   DateTime
  respondedAt DateTime?
  createdAt   DateTime @default(now())

  @@unique([orderId, providerId])
  @@index([providerId, status])
  @@index([status, expiresAt])
}

model GeocodeCache {
  id        String   @id @default(cuid())
  query     String   @unique
  lat       Float
  lng       Float
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model RouteCache {
  key       String   @id
  geometry  Json
  distanceM Int
  durationS Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id])
  orderId   String
  amount    Int
  method    String
  status    String
  reference String?  @unique
  collectedByProviderId String?
  paidAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
}

model SupportTicket {
  id        String   @id @default(cuid())
  subject   String
  message   String
  orderId   String?
  status    String   @default("OPEN")
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  createdAt DateTime @default(now())
  inboundEmails InboundEmail[]
  
  @@index([userId])
  @@index([status])
}

model PricingConfig {
  id                String   @id @default(cuid())
  version           Int      @unique
  isActive          Boolean  @default(true)
  currency          String   @default("ZAR")
  baseFare          Int
  minimumFare       Int
  distanceBands     Json
  distanceRates     Json
  freeWeightKg      Float    @default(1)
  weightBands       Json
  weightRates       Json
  volumetricDivisor Int      @default(5000)
  quoteTtlMinutes   Int      @default(15)
  createdBy         User?    @relation("PricingConfigCreatedBy", fields: [createdById], references: [id])
  createdById       String?
  quotes            Quote[]
  createdAt         DateTime @default(now())

  @@index([isActive])
}

model Quote {
  id                   String        @id @default(cuid())
  customer             User          @relation(fields: [customerId], references: [id])
  customerId           String
  status               String        @default("OPEN")
  source               String        @default("FORM")
  pickupAddress        String
  pickupPhone          String
  pickupDate           String?
  pickupTime           String?
  deliveryAddress      String
  deliveryName         String
  deliveryPhone        String
  deliveryInstructions String        @default("")
  pickupLat            Float
  pickupLng            Float
  deliveryLat          Float
  deliveryLng          Float
  distanceM            Int
  distanceKm           Float
  parcels              Json
  chargeableWeightKg   Float
  baseFare             Int
  distanceFare         Int
  weightFare           Int
  subtotal             Int
  total                Int
  currency             String        @default("ZAR")
  pricingConfig        PricingConfig @relation(fields: [pricingConfigId], references: [id])
  pricingConfigId      String
  pricingConfigVersion Int
  pricingSnapshot      Json
  expiresAt            DateTime
  consumedAt           DateTime?
  order                Order?        @relation(fields: [orderId], references: [id])
  orderId              String?       @unique
  createdAt            DateTime      @default(now())

  @@index([customerId])
  @@index([status])
  @@index([expiresAt])
}

model OrderParcel {
  id                 String   @id @default(cuid())
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId            String
  packageType        String
  catalogCategory    String?
  catalogSubcategory String?
  itemKey            String?
  itemLabel          String?
  description        String   @default("")
  length             Float
  width              Float
  height             Float
  actualWeightKg     Float
  quantity           Int      @default(1)
  chargeableWeightKg Float
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())

  @@index([orderId])
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model InboundEmail {
  id              String         @id @default(cuid())
  resendId        String         @unique
  from            String
  to              String
  subject         String
  html            String?
  text            String?
  processed       Boolean        @default(false)
  supportTicket   SupportTicket? @relation(fields: [supportTicketId], references: [id])
  supportTicketId String?
  createdAt       DateTime       @default(now())

  @@index([from])
  @@index([processed])
}

model ComplianceDocument {
  id                  String   @id @default(cuid())
  user                User     @relation("ProviderComplianceDocuments", fields: [userId], references: [id], onDelete: Cascade)
  userId              String
  type                String
  number              String?
  vehicleRegistration String?
  issuedAt            DateTime?
  expiresAt           DateTime
  fileKey             String?
  fileName            String?
  mimeType            String?
  sizeBytes           Int?
  status              String   @default("PENDING")
  notes               String?
  reviewedBy          User?    @relation("ComplianceDocumentReviewer", fields: [reviewedById], references: [id])
  reviewedById        String?
  reviewedAt          DateTime?
  reminders           ComplianceReminder[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId, type])
  @@index([status, expiresAt])
}

model ComplianceReminder {
  id            String             @id @default(cuid())
  document      ComplianceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId    String
  providerId    String
  thresholdDays Int
  channel       String             @default("EMAIL")
  sentAt        DateTime           @default(now())

  @@unique([documentId, thresholdDays])
  @@index([providerId, sentAt])
}

model Notification {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      String
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
}

model ConsentRecord {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  type       String
  version    String
  acceptedAt DateTime @default(now())

  @@unique([userId, type, version])
  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}