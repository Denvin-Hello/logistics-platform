// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String?   @unique
  emailVerified  DateTime?
  image          String?
  role           String    @default("CUSTOMER")
  status         String    @default("APPROVED")
  businessName   String?
  phone          String?
  serviceArea    String?
  vehicleType    String?
  vehicleCapacityKg Int?
  yearsExperience Int?
  declinedReason String?
  createdAt      DateTime  @default(now())
  accounts       Account[]
  sessions       Session[]
  orders         Order[]
  assignedOrders Order[]  @relation("ProviderAssignments")
  declines       OrderDecline[] @relation("ProviderDeclines")
  supportTickets SupportTicket[]

  @@index([role])
  @@index([status])
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?
  user               User    @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Order {
  id                   String   @id @default(cuid())
  orderNumber          String   @unique
  customer             User     @relation(fields: [customerId], references: [id])
  customerId           String
  customerName         String
  customerEmail        String
  pickupAddress        String
  pickupPhone          String
  pickupDate           String?
  pickupTime           String?
  deliveryAddress      String
  deliveryName         String
  deliveryPhone        String
  deliveryInstructions String
  packageType          String
  weight               Float
  length               Float
  width                Float
  height               Float
  packageDescription   String
  fragile              Boolean  @default(false)
  insurance            Boolean  @default(false)
  signatureRequired    Boolean  @default(false)
  amount               Int
  description          String
  paymentMethod        String
  paymentStatus        String
  status               String
  assignedProvider     User?    @relation("ProviderAssignments", fields: [assignedProviderId], references: [id])
  assignedProviderId   String?
  driverLat            Float?
  driverLng            Float?
  driverLocationUpdatedAt DateTime?
  baseAmount           Int?
  source               String   @default("FORM")
  packageCategory      String?
  pickupLat            Float?
  pickupLng            Float?
  deliveryLat          Float?
  deliveryLng          Float?
  acceptedAt           DateTime?
  startedAt            DateTime?
  deliveredAt          DateTime?
  paidAt               DateTime?
  arrivalDistanceM     Float?
  arrivalAccuracyM     Float?
  deliveryOverrideAt   DateTime?
  deliveryOverrideById String?
  deliveryOverrideReason String?
  payments             Payment[]
  declines             OrderDecline[]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([customerId])
  @@index([assignedProviderId])
  @@index([status])
  @@index([paymentStatus])
  @@index([source])
}

model OrderDecline {
  id         String   @id @default(cuid())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String
  provider   User     @relation("ProviderDeclines", fields: [providerId], references: [id])
  providerId String
  reason     String?
  createdAt  DateTime @default(now())

  @@unique([orderId, providerId])
  @@index([providerId])
}

model GeocodeCache {
  id        String   @id @default(cuid())
  query     String   @unique
  lat       Float
  lng       Float
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model RouteCache {
  key       String   @id
  geometry  Json
  distanceM Int
  durationS Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id])
  orderId   String
  amount    Int
  method    String
  status    String
  reference String?  @unique
  collectedByProviderId String?
  paidAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
}

model SupportTicket {
  id        String   @id @default(cuid())
  subject   String
  message   String
  orderId   String?
  status    String   @default("OPEN")
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  createdAt DateTime @default(now())
  inboundEmails InboundEmail[]
  
  @@index([userId])
  @@index([status])
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model InboundEmail {
  id              String         @id @default(cuid())
  resendId        String         @unique
  from            String
  to              String
  subject         String
  html            String?
  text            String?
  processed       Boolean        @default(false)
  supportTicket   SupportTicket? @relation(fields: [supportTicketId], references: [id])
  supportTicketId String?
  createdAt       DateTime       @default(now())

  @@index([from])
  @@index([processed])
}